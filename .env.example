# ── REQUIRED ────────────────────────────────────────────────────────────────

# Claude API (get at console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# JWT secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-64-char-random-hex

# ── OPTIONAL: cheaper model ──────────────────────────────────────────────────
# Unset = Claude Code default (Sonnet).
# Haiku is ~20x cheaper per token and still very capable for most tasks.
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── OPTIONAL: voice pipeline (voice/ directory only) ────────────────────────
# If you skip these, the browser mic button (Web Speech API) works for free.

# Deepgram STT — free tier: 12,000 min/year  https://console.deepgram.com
DEEPGRAM_API_KEY=

# Cartesia TTS — paid per character  https://play.cartesia.ai
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=bf0a246a-8642-498a-9950-80c35e9276b5

# ── SERVER ──────────────────────────────────────────────────────────────────
SERVER_PORT=3001
LOG_LEVEL=info
