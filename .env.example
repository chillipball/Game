# ── REQUIRED ────────────────────────────────────────────────────────────────

# JWT secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-64-char-random-hex

# ── CLAUDE AUTH ──────────────────────────────────────────────────────────────
# Authenticate ONCE with your Claude.ai subscription (Pro/Max) — no API key needed:
#
#   claude auth login
#
# This opens a browser, signs in with your Claude.ai account, and stores
# credentials locally. The server reads them automatically via the claude CLI.
#
# Only uncomment ANTHROPIC_API_KEY below if you prefer per-token API billing instead.
# ANTHROPIC_API_KEY=sk-ant-...

# ── OPTIONAL: model override ─────────────────────────────────────────────────
# Leave unset to use your plan's default model.
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── OPTIONAL: voice pipeline (voice/ directory only) ────────────────────────
# Skip these if you use the browser 🎤 button (Web Speech API, free).

# Deepgram STT — free tier: 12,000 min/year  https://console.deepgram.com
DEEPGRAM_API_KEY=

# Cartesia TTS — paid per character  https://play.cartesia.ai
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=bf0a246a-8642-498a-9950-80c35e9276b5

# ── SERVER ──────────────────────────────────────────────────────────────────
SERVER_PORT=3001
LOG_LEVEL=info
